@model EMS.Models.EmployeeProfileViewModel
@{ ViewData["Title"] = "My Profile"; }

<div class="container-fluid px-0">
    <div class="content-card">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div><h2 class="mb-1">My Profile</h2><p class="text-muted mb-0">View and update your personal information.</p></div>
            <a asp-controller="Home" asp-action="EmployeeDashboard" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Dashboard</a>
        </div>
        <form asp-controller="Profile" asp-action="Index" method="post" enctype="multipart/form-data" id="profileForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-4">
                <div class="col-lg-3 text-center">
                    @if (!string.IsNullOrWhiteSpace(Model.PhotoPath)) { <img src="@Model.PhotoPath" alt="Employee profile picture" class="rounded-circle border mb-3" style="width:150px;height:150px;object-fit:cover" /> }
                    else { <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center mx-auto mb-3" style="width:150px;height:150px;font-size:3rem;color:#0f9f95"><i class="bi bi-person-fill"></i></div> }
                    <div class="text-start"><label asp-for="PhotoFile" class="form-label"></label><input asp-for="PhotoFile" class="form-control editable-field" type="file" accept=".jpg,.jpeg,.png,.webp" disabled /><span asp-validation-for="PhotoFile" class="text-danger small"></span><small class="text-muted">JPG, PNG or WEBP; max 2 MB.</small></div>
                    <div class="small text-muted mt-3">Employee ID: <strong>@Model.EmployeeCode</strong></div>
                </div>
                <div class="col-lg-9">
                    <h5 class="mb-3">Personal Details</h5>
                    <div class="row g-3">
                        <div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control editable-field" disabled /><span asp-validation-for="FirstName" class="text-danger small"></span></div>
                        <div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control editable-field" disabled /><span asp-validation-for="LastName" class="text-danger small"></span></div>
                        <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control editable-field" disabled /><span asp-validation-for="Email" class="text-danger small"></span></div>
                        <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control editable-field" disabled /><span asp-validation-for="Phone" class="text-danger small"></span></div>
                        <div class="col-md-6"><label asp-for="Gender" class="form-label"></label><select asp-for="Gender" class="form-select editable-field" disabled><option value="">Select gender</option><option>Female</option><option>Male</option><option>Other</option></select><span asp-validation-for="Gender" class="text-danger small"></span></div>
                        <div class="col-md-6"><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" type="date" class="form-control editable-field" disabled /><span asp-validation-for="DateOfBirth" class="text-danger small"></span></div>
                        <div class="col-12"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" class="form-control editable-field" rows="2" disabled></textarea><span asp-validation-for="Address" class="text-danger small"></span></div>
                    </div>
                    <hr class="my-4" /><h5 class="mb-3">Employment Details <span class="text-muted small">(read-only)</span></h5>
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label">Department</label><input class="form-control" value="@Model.DepartmentName" readonly /></div>
                        <div class="col-md-6"><label class="form-label">Designation</label><input class="form-control" value="@Model.DesignationTitle" readonly /></div>
                        <div class="col-md-6"><label class="form-label">Joining Date</label><input class="form-control" value="@Model.HireDate.ToString("dd MMM yyyy")" readonly /></div>
                        <div class="col-md-6"><label class="form-label">Salary</label><input class="form-control" value="@Model.Salary.ToString("C")" readonly /></div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="button" id="editBtn" class="btn btn-primary"><i class="bi bi-pencil-square me-1"></i>Edit Profile</button>
                        <button type="submit" id="saveBtn" class="btn btn-success" disabled><i class="bi bi-check-lg me-1"></i>Save Changes</button>
                        <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-primary"><i class="bi bi-key me-1"></i>Change Password</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('editBtn').addEventListener('click', function () {
            document.querySelectorAll('.editable-field').forEach(function (el) { el.disabled = false; });
            document.getElementById('saveBtn').disabled = false;
            this.disabled = true;
        });
    </script>
}
