@model LoginViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Login";
}

<div class="auth-wrapper">
    <div class="auth-side">
        <div class="auth-side-icon"><i class="bi bi-diagram-3-fill"></i></div>
        <h2>Employee Management<br />System</h2>
        <p>A centralized platform to manage employees, departments and designations with ease and accuracy.</p>

        <div class="auth-feature-list">
            <div><i class="bi bi-check-circle-fill"></i> Complete employee records &amp; profiles</div>
            <div><i class="bi bi-check-circle-fill"></i> Department &amp; designation management</div>
            <div><i class="bi bi-check-circle-fill"></i> Real-time analytics dashboard</div>
            <div><i class="bi bi-check-circle-fill"></i> Secure role-based access</div>
        </div>
    </div>

    <div class="auth-form-side">
        <h3>Welcome back</h3>
        <p class="subtitle">Sign in to access your dashboard</p>

        <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="needs-validation" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger custom-alert" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label">Username</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                    <input asp-for="Username" class="form-control" placeholder="Enter your username" autofocus required />
                </div>
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-lock"></i></span>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" required />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label small">Remember me</label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">
                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
            </button>

            <div class="demo-credentials">
                <i class="bi bi-info-circle me-1"></i> Demo credentials — Username: <code>admin</code> &nbsp; Password: <code>Admin@123</code>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
