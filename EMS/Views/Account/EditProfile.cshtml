@model EMS.Models.ProfileViewModel
@{ ViewData["Title"] = "Edit Profile"; }
<div class="row justify-content-center"><div class="col-xl-9 col-lg-10"><div class="content-card">
    <div class="d-flex align-items-center gap-3 mb-4"><div class="stat-icon bg-blue"><i class="bi bi-person-gear"></i></div><div><h3 class="mb-1">Edit My Profile</h3><p class="text-muted mb-0">Update your personal details and profile picture.</p></div></div>
    @if (!string.IsNullOrWhiteSpace(Model.PhotoPath)) { <img src="@Model.PhotoPath" alt="Current profile picture" class="rounded-circle border shadow-sm mb-3" style="width:100px;height:100px;object-fit:cover" /> }
    else { <div class="rounded-circle d-inline-flex align-items-center justify-content-center text-white shadow-sm mb-3" style="width:100px;height:100px;background:#0f9488;font-size:2rem;font-weight:600">@(string.IsNullOrWhiteSpace(Model.FullName) ? "E" : Model.FullName.Substring(0, 1).ToUpperInvariant())</div> }
    <form asp-action="EditProfile" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <h5 class="mb-3">Personal Details</h5><div class="row g-3">
            <div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control"/><span asp-validation-for="FullName" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control"/><span asp-validation-for="Email" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control"/><span asp-validation-for="Phone" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="Gender" class="form-label"></label><select asp-for="Gender" class="form-select"><option value="">Select gender</option><option>Male</option><option>Female</option><option>Other</option></select><span asp-validation-for="Gender" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="DateOfBirth" class="form-label">Date of Birth</label><input asp-for="DateOfBirth" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control"/><span asp-validation-for="DateOfBirth" class="text-danger small"></span></div>
            <div class="col-12"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" class="form-control" rows="3" maxlength="250"></textarea><span asp-validation-for="Address" class="text-danger small"></span></div>
            <div class="col-12"><label asp-for="PhotoFile" class="form-label">Profile Picture</label><input asp-for="PhotoFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control"/><div class="form-text">JPG, PNG or WEBP; maximum 2 MB.</div><span asp-validation-for="PhotoFile" class="text-danger small"></span></div>
        </div>
        <div class="alert alert-light border mt-4"><i class="bi bi-info-circle me-2"></i>Employee code, department, designation, salary and joining date are managed by Admin.</div>
        <div class="d-flex flex-wrap gap-2 mt-3"><button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save Changes</button><a asp-controller="Home" asp-action="EmployeeDashboard" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Dashboard</a><a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-primary"><i class="bi bi-shield-lock me-1"></i>Change Password</a></div>
    </form>
</div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
