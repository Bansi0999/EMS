@model Employee
@{
    ViewData["Title"] = "Employee Details";
}

<div class="content-card">
    <div class="d-flex flex-column flex-md-row align-items-md-center gap-4 mb-4 pb-4" style="border-bottom: 1px solid var(--border);">
        @if (!string.IsNullOrEmpty(Model.PhotoPath))
        {
            <img src="@Model.PhotoPath" class="avatar-lg" alt="@Model.FullName" />
        }
        else
        {
            <div class="avatar-lg-placeholder">@Model.FirstName.Substring(0,1)@Model.LastName.Substring(0,1)</div>
        }
        <div class="flex-grow-1">
            <h3 class="mb-1">@Model.FullName</h3>
            <p class="text-muted mb-2">@Model.Designation?.Title &bull; @Model.Department?.DepartmentName</p>
            @if (Model.IsActive)
            {
                <span class="badge-status badge-active">Active</span>
            }
            else
            {
                <span class="badge-status badge-inactive">Inactive</span>
            }
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.EmployeeId" class="btn btn-primary"><i class="bi bi-pencil me-1"></i> Edit</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <h6 class="section-title">Personal Information</h6>
            <dl class="row mb-0">
                <dt class="col-5 text-muted fw-normal">Employee Code</dt>
                <dd class="col-7">@Model.EmployeeCode</dd>
                <dt class="col-5 text-muted fw-normal">Gender</dt>
                <dd class="col-7">@Model.Gender</dd>
                <dt class="col-5 text-muted fw-normal">Date of Birth</dt>
                <dd class="col-7">@Model.DateOfBirth.ToString("dd MMM yyyy")</dd>
                <dt class="col-5 text-muted fw-normal">Address</dt>
                <dd class="col-7">@(Model.Address ?? "—")</dd>
            </dl>
        </div>
        <div class="col-md-6">
            <h6 class="section-title">Contact Information</h6>
            <dl class="row mb-0">
                <dt class="col-5 text-muted fw-normal">Email</dt>
                <dd class="col-7">@Model.Email</dd>
                <dt class="col-5 text-muted fw-normal">Phone</dt>
                <dd class="col-7">@Model.Phone</dd>
            </dl>
        </div>
        <div class="col-md-6">
            <h6 class="section-title">Employment Details</h6>
            <dl class="row mb-0">
                <dt class="col-5 text-muted fw-normal">Department</dt>
                <dd class="col-7"><span class="badge-dept">@Model.Department?.DepartmentName</span></dd>
                <dt class="col-5 text-muted fw-normal">Designation</dt>
                <dd class="col-7">@Model.Designation?.Title</dd>
                <dt class="col-5 text-muted fw-normal">Hire Date</dt>
                <dd class="col-7">@Model.HireDate.ToString("dd MMM yyyy")</dd>
                <dt class="col-5 text-muted fw-normal">Monthly Salary</dt>
                <dd class="col-7">@Model.Salary.ToString("C")</dd>
            </dl>
        </div>
    </div>
</div>
