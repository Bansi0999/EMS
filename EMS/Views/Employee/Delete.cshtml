@model Employee
@{
    ViewData["Title"] = "Delete Employee";
}

<div class="content-card" style="max-width: 560px; margin: 0 auto;">
    <div class="text-center mb-4">
        <i class="bi bi-exclamation-triangle text-danger" style="font-size: 48px;"></i>
        <h4 class="mt-3">Delete this employee?</h4>
        <p class="text-muted">This action cannot be undone. All data related to this employee will be permanently removed.</p>
    </div>

    <div class="d-flex align-items-center gap-3 p-3 mb-4" style="background:#F8FAFC; border-radius: var(--radius-sm);">
        @if (!string.IsNullOrEmpty(Model.PhotoPath))
        {
            <img src="@Model.PhotoPath" class="avatar-sm" style="width:52px;height:52px;" alt="@Model.FullName" />
        }
        else
        {
            <div class="avatar-placeholder" style="width:52px;height:52px;">@Model.FirstName.Substring(0,1)@Model.LastName.Substring(0,1)</div>
        }
        <div>
            <div class="fw-semibold">@Model.FullName</div>
            <div class="text-muted small">@Model.EmployeeCode &bull; @Model.Department?.DepartmentName &bull; @Model.Designation?.Title</div>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="EmployeeId" />
        <div class="d-flex gap-2 justify-content-center">
            <button type="submit" class="btn btn-danger px-4"><i class="bi bi-trash me-1"></i> Yes, Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
        </div>
    </form>
</div>
