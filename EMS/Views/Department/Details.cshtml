@model Department
@{
    ViewData["Title"] = "Department Details";
}

<div class="content-card mb-4">
    <div class="d-flex justify-content-between align-items-start">
        <div class="d-flex gap-3">
            <div class="stat-icon bg-blue"><i class="bi bi-building"></i></div>
            <div>
                <h3 class="mb-1">@Model.DepartmentName</h3>
                <p class="text-muted mb-0">@(Model.Description ?? "No description provided.")</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.DepartmentId" class="btn btn-primary"><i class="bi bi-pencil me-1"></i> Edit</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="stat-card">
            <div class="stat-icon bg-teal"><i class="bi bi-people-fill"></i></div>
            <div>
                <div class="stat-value">@(Model.Employees?.Count ?? 0)</div>
                <div class="stat-label">Total Employees</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="stat-card">
            <div class="stat-icon bg-amber"><i class="bi bi-briefcase-fill"></i></div>
            <div>
                <div class="stat-value">@(Model.Designations?.Count ?? 0)</div>
                <div class="stat-label">Designations</div>
            </div>
        </div>
    </div>
</div>

<div class="table-card">
    <div class="p-3 border-bottom"><h5 class="mb-0 fw-semibold">Designations in this Department</h5></div>
    <div class="table-responsive">
        <table class="table mb-0">
            <thead><tr><th>Title</th><th>Employees</th></tr></thead>
            <tbody>
                @if (Model.Designations == null || !Model.Designations.Any())
                {
                    <tr><td colspan="2" class="text-center text-muted py-4">No designations yet.</td></tr>
                }
                else
                {
                    @foreach (var d in Model.Designations)
                    {
                        <tr>
                            <td>@d.Title</td>
                            <td>@(d.Employees?.Count ?? 0)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
