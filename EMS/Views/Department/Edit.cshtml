@model Department
@{
    ViewData["Title"] = "Edit Department";
}

<div class="content-card" style="max-width: 620px;">
    <form asp-action="Edit" asp-route-id="@Model.DepartmentId" method="post" class="needs-validation" novalidate>
        <input type="hidden" asp-for="DepartmentId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger custom-alert"></div>

        <div class="mb-3">
            <label asp-for="DepartmentName" class="form-label">Department Name</label>
            <input asp-for="DepartmentName" class="form-control" required />
            <span asp-validation-for="DepartmentName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i> Update Department</button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
