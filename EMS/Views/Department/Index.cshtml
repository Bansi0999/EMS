@model IEnumerable<Department>
@{
    ViewData["Title"] = "Departments";
}

<div class="filter-bar">
    <form method="get" asp-action="Index" class="row g-2">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Search departments..." />
            </div>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-navy w-100"><i class="bi bi-funnel me-1"></i>Search</button>
        </div>
    </form>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count() department(s) found</p>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Add Department</a>
</div>

<div class="row g-3">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="content-card text-center py-5 text-muted">
                <i class="bi bi-building" style="font-size: 32px;"></i>
                <p class="mb-0 mt-2">No departments found.</p>
            </div>
        </div>
    }
    else
    {
        @foreach (var dept in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="content-card h-100">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="stat-icon bg-blue"><i class="bi bi-building"></i></div>
                        <span class="badge-dept">@(dept.Employees?.Count ?? 0) employees</span>
                    </div>
                    <h5 class="mt-3 mb-1">@dept.DepartmentName</h5>
                    <p class="text-muted small mb-3">@(dept.Description ?? "No description provided.")</p>
                    <div class="d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@dept.DepartmentId" class="btn btn-sm btn-light flex-fill">View</a>
                        <a asp-action="Edit" asp-route-id="@dept.DepartmentId" class="btn btn-sm btn-light btn-sm-icon" title="Edit"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete" asp-route-id="@dept.DepartmentId" class="btn btn-sm btn-light btn-sm-icon text-danger" title="Delete"><i class="bi bi-trash"></i></a>
                    </div>
                </div>
            </div>
        }
    }
</div>
