@model Department
@{
    ViewData["Title"] = "Add Department";
}

<div class="content-card" style="max-width: 620px;">
    <form asp-action="Create" method="post" class="needs-validation" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger custom-alert"></div>

        <div class="mb-3">
            <label asp-for="DepartmentName" class="form-label">Department Name</label>
            <input asp-for="DepartmentName" class="form-control" placeholder="e.g. Human Resources" required />
            <span asp-validation-for="DepartmentName" class="text-danger small"></span>
        </div>
        @* DEMO *@
        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Briefly describe this department's role..."></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i> Save Department</button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
