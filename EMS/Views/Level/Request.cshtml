@model EMS.Models.EmployeeLevel
@{ ViewData["Title"]="Request Level Change"; }
<div class="card shadow-sm"><div class="card-body p-4"><h3 class="mb-4">Request Level Change</h3><form asp-action="Request" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="LevelId" class="form-label">Select Level</label><select asp-for="LevelId" class="form-select mb-3"><option value="">Select level</option>@foreach(var l in ViewBag.Levels){<option value="@l.LevelId">@l.LevelName - @l.Description</option>}</select><span asp-validation-for="LevelId" class="text-danger"></span><label asp-for="Remarks" class="form-label">Remarks</label><textarea asp-for="Remarks" class="form-control" rows="4" placeholder="Reason for level change..."></textarea><div class="mt-4"><button class="btn btn-primary">Submit Request</button> <a asp-action="MyLevel" class="btn btn-light">Cancel</a></div></form></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
