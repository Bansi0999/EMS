@model EMS.Models.EmployeeLevel?
@{ ViewData["Title"]="My Level"; var pending = ViewBag.Pending as IEnumerable<EMS.Models.EmployeeLevel> ?? Enumerable.Empty<EMS.Models.EmployeeLevel>(); }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="mb-1">My Level</h2><p class="text-muted mb-0">View your approved level and pending requests.</p></div><a asp-action="Request" class="btn btn-primary">Request Level Change</a></div>
<div class="card shadow-sm mb-4"><div class="card-body"><h5>Current Approved Level</h5>@if(Model!=null){<h3 class="mt-3">@Model.Level?.LevelName</h3><span class="badge bg-success">Approved</span>}else{<p class="text-muted mt-3 mb-0">No approved level assigned yet.</p>}</div></div>
@if(pending.Any()){<div class="card shadow-sm"><div class="card-body"><h5>Pending Requests</h5>@foreach(var p in pending){<div class="border rounded p-3 mt-3"><strong>@p.Level?.LevelName</strong><span class="badge bg-warning text-dark ms-2">Pending</span></div>}</div></div>}
