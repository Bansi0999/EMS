@model IEnumerable<EMS.Models.EmployeeLevel>
@{ ViewData["Title"]="Level Approvals"; }
<h2 class="mb-1">Level Approvals</h2><p class="text-muted mb-4">Approve or reject employee level requests.</p>
<div class="card shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Employee</th><th>Requested Level</th><th>Requested Date</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.Employee?.FullName<br><small>@r.Employee?.EmployeeCode</small></td><td>@r.Level?.LevelName</td><td>@r.RequestedDate.ToString("dd MMM yyyy")</td><td><span class="badge @(r.Status=="Approved"?"bg-success":r.Status=="Rejected"?"bg-danger":"bg-warning text-dark")">@r.Status</span></td><td>@if(r.Status=="Pending"){<div class="d-flex gap-1"><form asp-action="Approve" method="post"><input type="hidden" name="id" value="@r.EmployeeLevelId"/><button class="btn btn-sm btn-success" onclick="return confirm('Approve this request?')">Approve</button></form><form asp-action="Reject" method="post"><input type="hidden" name="id" value="@r.EmployeeLevelId"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Reject this request?')">Reject</button></form></div>}</td></tr>}</tbody></table></div></div>
