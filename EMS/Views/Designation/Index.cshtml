@model IEnumerable<Designation>
@{
    ViewData["Title"] = "Designations";
}

<div class="filter-bar">
    <form method="get" asp-action="Index" class="row g-2">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Search designations..." />
            </div>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-navy w-100"><i class="bi bi-funnel me-1"></i>Search</button>
        </div>
    </form>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count() designation(s) found</p>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Add Designation</a>
</div>

<div class="table-card">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Department</th>
                    <th>Employees</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-5">No designations found.</td></tr>
                }
                else
                {
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@d.Title</td>
                            <td><span class="badge-dept">@d.Department?.DepartmentName</span></td>
                            <td>@(d.Employees?.Count ?? 0)</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@d.DesignationId" class="btn btn-sm btn-light btn-sm-icon" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@d.DesignationId" class="btn btn-sm btn-light btn-sm-icon text-danger" title="Delete"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
