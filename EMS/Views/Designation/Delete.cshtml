@model Designation
@{
    ViewData["Title"] = "Delete Designation";
}

<div class="content-card" style="max-width: 560px; margin: 0 auto;">
    <div class="text-center mb-4">
        <i class="bi bi-exclamation-triangle text-danger" style="font-size: 48px;"></i>
        <h4 class="mt-3">Delete this designation?</h4>
        <p class="text-muted">This action cannot be undone.</p>
    </div>

    @if (Model.Employees != null && Model.Employees.Any())
    {
        <div class="alert alert-warning custom-alert">
            <i class="bi bi-exclamation-circle me-1"></i>
            This designation has <strong>@Model.Employees.Count</strong> employee(s) assigned. Reassign them before deleting.
        </div>
    }

    <div class="d-flex align-items-center gap-3 p-3 mb-4" style="background:#F8FAFC; border-radius: var(--radius-sm);">
        <div class="stat-icon bg-amber"><i class="bi bi-briefcase-fill"></i></div>
        <div>
            <div class="fw-semibold">@Model.Title</div>
            <div class="text-muted small">@Model.Department?.DepartmentName</div>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="DesignationId" />
        <div class="d-flex gap-2 justify-content-center">
            <button type="submit" class="btn btn-danger px-4" @(Model.Employees != null && Model.Employees.Any() ? "disabled" : "")><i class="bi bi-trash me-1"></i> Yes, Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
        </div>
    </form>
</div>
