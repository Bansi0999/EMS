@model Designation
@{
    ViewData["Title"] = "Add Designation";
}

<div class="content-card" style="max-width: 620px;">
    <form asp-action="Create" method="post" class="needs-validation" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger custom-alert"></div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label">Designation Title</label>
            <input asp-for="Title" class="form-control" placeholder="e.g. Software Engineer" required />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DepartmentId" class="form-label">Department</label>
            <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.Departments" required>
                <option value="">-- Select Department --</option>
            </select>
            <span asp-validation-for="DepartmentId" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i> Save Designation</button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
