@model IEnumerable<EMS.Models.LeaveRequest>
@{ ViewData["Title"]="Leave Management"; }
<h2 class="mb-1">Leave Management</h2><p class="text-muted mb-4">Review employee leave applications.</p>
<div class="card shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Employee</th><th>Type</th><th>Dates</th><th>Reason</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var l in Model){<tr><td>@l.Employee?.FullName<br><small>@l.Employee?.EmployeeCode</small></td><td>@l.LeaveType</td><td>@l.FromDate.ToString("dd MMM yyyy") - @l.ToDate.ToString("dd MMM yyyy")</td><td>@l.Reason</td><td><span class="badge @(l.Status=="Approved"?"bg-success":l.Status=="Rejected"?"bg-danger":"bg-warning text-dark")">@l.Status</span></td><td>@if(l.Status=="Pending"){<div class="d-flex gap-1"><form asp-action="Approve" method="post"><input type="hidden" name="id" value="@l.LeaveRequestId"/><button class="btn btn-sm btn-success" onclick="return confirm('Approve this request?')">Approve</button></form><form asp-action="Reject" method="post"><input type="hidden" name="id" value="@l.LeaveRequestId"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Reject this request?')">Reject</button></form></div>}</td></tr>}</tbody></table></div></div>
