@model IEnumerable<EMS.Models.LeaveRequest>
@{ ViewData["Title"]="My Leaves"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="mb-1">My Leaves</h2><p class="text-muted mb-0">Track your leave applications.</p></div><a asp-action="Apply" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Apply Leave</a></div>
<div class="card shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Type</th><th>From</th><th>To</th><th>Reason</th><th>Status</th></tr></thead><tbody>@foreach(var l in Model){<tr><td>@l.LeaveType</td><td>@l.FromDate.ToString("dd MMM yyyy")</td><td>@l.ToDate.ToString("dd MMM yyyy")</td><td>@l.Reason</td><td><span class="badge @(l.Status=="Approved"?"bg-success":l.Status=="Rejected"?"bg-danger":"bg-warning text-dark")">@l.Status</span></td></tr>}</tbody></table></div></div>
@if(!Model.Any()){<div class="alert alert-info mt-3">You have not submitted any leave applications.</div>}
