@model EMS.Models.Salary
@{ ViewData["Title"]="Add Salary"; }
<div class="card shadow-sm"><div class="card-body p-4"><h3 class="mb-4">Add Salary</h3><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="EmployeeId" class="form-label">Employee</label><select asp-for="EmployeeId" class="form-select"><option value="">Select employee</option>@foreach(var e in ViewBag.Employees){<option value="@e.EmployeeId">@e.EmployeeCode - @e.FullName</option>}</select><span asp-validation-for="EmployeeId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Month" class="form-label"></label><input asp-for="Month" type="month" class="form-control"/><span asp-validation-for="Month" class="text-danger"></span></div><div class="col-md-4"><label asp-for="BasicSalary" class="form-label"></label><input asp-for="BasicSalary" class="form-control"/></div><div class="col-md-4"><label asp-for="Allowances" class="form-label"></label><input asp-for="Allowances" class="form-control"/></div><div class="col-md-4"><label asp-for="Deductions" class="form-label"></label><input asp-for="Deductions" class="form-control"/></div></div><div class="mt-4"><button class="btn btn-primary">Save Salary</button> <a asp-action="Index" class="btn btn-light">Cancel</a></div></form></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
