@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Employee Management System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <div class="brand-icon"><i class="bi bi-diagram-3-fill"></i></div>
                <div class="brand-text">
                    <span class="brand-title">EMS</span>
                    <span class="brand-subtitle">Employee Manager</span>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section-label">Main</div>
                @if (User.IsInRole("Admin"))
                {
                    <a class="nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> <span>Dashboard</span></a>
                    <div class="nav-section-label">Management</div>
                    <a class="nav-link @(currentController == "Employee" ? "active" : "")" asp-controller="Employee" asp-action="Index"><i class="bi bi-people-fill"></i> <span>Employees</span></a>
                    <a class="nav-link @(currentController == "Department" ? "active" : "")" asp-controller="Department" asp-action="Index"><i class="bi bi-building"></i> <span>Departments</span></a>
                    <a class="nav-link @(currentController == "Designation" ? "active" : "")" asp-controller="Designation" asp-action="Index"><i class="bi bi-briefcase-fill"></i> <span>Designations</span></a>
                    <a class="nav-link @(currentController == "Salary" ? "active" : "")" asp-controller="Salary" asp-action="Index"><i class="bi bi-cash-stack"></i> <span>Salary</span></a>
                    <a class="nav-link @(currentController == "Leave" ? "active" : "")" asp-controller="Leave" asp-action="Index"><i class="bi bi-calendar-check"></i> <span>Leave Approvals</span></a>
                    <a class="nav-link @(currentController == "Level" ? "active" : "")" asp-controller="Level" asp-action="Index"><i class="bi bi-bar-chart-steps"></i> <span>Level Approvals</span></a>
                }
                else if (User.IsInRole("Employee"))
                {
                    <a class="nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="EmployeeDashboard"><i class="bi bi-speedometer2"></i> <span>My Dashboard</span></a>
                    <div class="nav-section-label">My Work</div>
                    <a class="nav-link @(currentController == "Profile" ? "active" : "")" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle"></i> <span>My Profile</span></a>
                    <a class="nav-link @(currentController == "Salary" ? "active" : "")" asp-controller="Salary" asp-action="MySalary"><i class="bi bi-cash-stack"></i> <span>My Salary</span></a>
                    <a class="nav-link @(currentController == "Leave" ? "active" : "")" asp-controller="Leave" asp-action="Apply"><i class="bi bi-calendar-plus"></i> <span>Apply Leave</span></a>
                    <a class="nav-link @(currentController == "Leave" ? "active" : "")" asp-controller="Leave" asp-action="MyLeaves"><i class="bi bi-calendar-check"></i> <span>My Leaves</span></a>
                    <a class="nav-link @(currentController == "Level" ? "active" : "")" asp-controller="Level" asp-action="MyLevel"><i class="bi bi-bar-chart-steps"></i> <span>My Level</span></a>
                }
            </nav>

            <div class="sidebar-footer">
                <div class="user-mini-card">
                    <div class="user-avatar">@(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "U")</div>
                    <div class="user-mini-info">
                        <span class="user-mini-name">@User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</span>
                        <span class="user-mini-role">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main content -->
        <div class="main-content">
            <header class="topbar">
                <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
                    <i class="bi bi-list"></i>
                </button>
                <h1 class="page-title">@ViewData["Title"]</h1>
                <div class="topbar-right">
                    <div class="dropdown">
                        <button class="btn topbar-user-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="topbar-avatar">@(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "U")</span>
                            <span class="d-none d-sm-inline">@User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>Change Password</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="page-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show custom-alert" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show custom-alert" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <footer class="page-footer">
                &copy; @DateTime.Now.Year Employee Management System &mdash; Final Year Project
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
