@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="content-card text-center py-5">
    <i class="bi bi-exclamation-octagon text-danger" style="font-size: 56px;"></i>
    <h2 class="mt-3">Something went wrong</h2>
    <p class="text-muted">An unexpected error occurred while processing your request.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Back to Dashboard</a>
</div>
